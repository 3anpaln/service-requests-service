<Project Sdk="Microsoft.NET.Sdk.Web">

    <PropertyGroup>
        <TargetFramework>net10.0</TargetFramework>
        <Nullable>enable</Nullable>
        <ImplicitUsings>enable</ImplicitUsings>
        <RootNamespace>service_requests_service</RootNamespace>
    </PropertyGroup>

    <ItemGroup>
      <Folder Include="BackgroundServices\" />
    </ItemGroup>

    <ItemGroup>
      <PackageReference Include="FluentValidation" Version="12.2.0" />
      <PackageReference Include="FluentValidation.DependencyInjectionExtensions" Version="12.2.0" />
      <PackageReference Include="Microsoft.EntityFrameworkCore" Version="10.0.14" />
      <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.14">
        <PrivateAssets>all</PrivateAssets>
        <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      </PackageReference>
      <PackageReference Include="Newtonsoft.Json.Schema" Version="4.0.2" />
      <PackageReference Include="Npgsql.EntityFrameworkCore.PostgreSQL" Version="10.0.3" />
    </ItemGroup>

</Project>
